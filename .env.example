# =============================================================================
# Mysuru Civic Connect (MCC) — Frontend Environment Configuration
# =============================================================================

# 1. Supabase Cloud Configuration
# Retrieve from: Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 2. Node.js / Express Backend URL (AWS S3 Presigned URL Engine)
# Local development default: http://localhost:4000
# Production / EC2 / CloudFront default: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:4000

# 3. Mysuru Municipal Default Map Center (Sayyaji Rao Road)
VITE_MAP_DEFAULT_LAT=12.2958
VITE_MAP_DEFAULT_LNG=76.6394

# 4. Civic SLA Thresholds (Hours)
VITE_SLA_HIGH_HOURS=24
VITE_SLA_MEDIUM_HOURS=72
VITE_SLA_LOW_HOURS=168
