# =============================================================================
# Mysuru Civic Connect (MCC) — Backend Environment Configuration
# =============================================================================

NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://mcc-frontend.onrender.com

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AWS S3 Private Storage Engine (ap-southeast-1 Singapore)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
